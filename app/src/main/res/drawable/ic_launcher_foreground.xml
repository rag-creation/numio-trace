<?xml version="1.0" encoding="utf-8"?>
<!--
  Trace by Numio icon: a timeline where each gap-separated dot is a past time you did
  something, ending in an amber tick for "done now", in Numio amber.
  Same size box as the Calendar icon (the Numio standard). Based on RR's design.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- the timeline: dashes with a gap around each dot -->
    <path android:strokeColor="#F1EEE6" android:strokeWidth="3" android:strokeLineCap="round"
        android:pathData="M54,29.5 L54,33.5 M54,45.5 L54,49.5 M54,61.5 L54,62.5" />
    <!-- two past times -->
    <path android:fillColor="#F1EEE6" android:pathData="M51.8,39.5 A2.2,2.2 0 1,0 56.2,39.5 A2.2,2.2 0 1,0 51.8,39.5 Z" />
    <path android:fillColor="#F1EEE6" android:pathData="M51.8,55.5 A2.2,2.2 0 1,0 56.2,55.5 A2.2,2.2 0 1,0 51.8,55.5 Z" />
    <!-- done now: amber circle with a dark tick -->
    <path android:fillColor="#FFC21A" android:pathData="M47,73.5 A7,7 0 1,0 61,73.5 A7,7 0 1,0 47,73.5 Z" />
    <path android:strokeColor="#1A1400" android:strokeWidth="2" android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M51.1,73.7 L53.3,75.9 L57.3,71.4" />
</vector>
