<?xml version="1.0" encoding="utf-8"?>
<!--
  Trace by Numio icon: a timeline where each gap-separated dot is a past time you did
  something, ending in an amber tick for "done now", in Numio amber.
  Same size box as the Calendar icon (the Numio standard). Based on RR's design.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- the timeline: dashes with a gap around each dot -->
    <path android:strokeColor="#F1EEE6" android:strokeWidth="4.5" android:strokeLineCap="round"
        android:pathData="M54,24.25 L54,28.75 M54,43.25 L54,47.75 M54,62.25 L54,63.25" />
    <!-- two past times -->
    <path android:fillColor="#F1EEE6" android:pathData="M51.4,36 A2.6,2.6 0 1,0 56.6,36 A2.6,2.6 0 1,0 51.4,36 Z" />
    <path android:fillColor="#F1EEE6" android:pathData="M51.4,55 A2.6,2.6 0 1,0 56.6,55 A2.6,2.6 0 1,0 51.4,55 Z" />
    <!-- done now: amber circle with a dark tick -->
    <path android:fillColor="#FFC21A" android:pathData="M44.5,77.4 A9.5,9.5 0 1,0 63.5,77.4 A9.5,9.5 0 1,0 44.5,77.4 Z" />
    <path android:strokeColor="#1A1400" android:strokeWidth="2.7" android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M49.2,77.7 L52.2,80.7 L57.6,74.6" />
</vector>
